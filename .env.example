# App mode
VITE_AUTH_MODE=demo

# Demo admin access is disabled by default. Do not use this for production.
VITE_ENABLE_DEMO_ADMIN=false
VITE_DEMO_ADMIN_ACCESS_CODE=

# Supabase browser config. The anon key is public, but production data safety
# depends on Supabase Auth, Row Level Security, and role-based policies.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function CORS, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173
